# LiveKit server credentials (from cloud.livekit.io project settings, or your self-hosted server)
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# The wss:// URL of your LiveKit server/project
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# That's it — no TEACHERS list and no shared host passcode needed. Any
# teacher can create their own class from the homepage with their own name,
# email and a room password of their choosing (see README).
